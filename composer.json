{
    "name": "1tomany/php-geocoder",
    "description": "A simple framework-independent geocoding library",
    "license": "MIT",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": [
        "geocode",
        "geocoder",
        "geocoding",
        "google maps"
    ],
    "require": {
        "php": ">=8.5",
        "symfony/http-client": "^7.2|^8.0|^8.1",
        "symfony/serializer": "^7.2|^8.0|^8.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpstan/phpstan": "^2.1.55",
        "phpunit/phpunit": "^13.1.11"
    },
    "autoload": {
        "psr-4": {
            "OneToMany\\Geocoder\\": "src/"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OneToMany\\Geocoder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "fix": "php-cs-fixer fix",
        "stan": "phpstan",
        "test": "phpunit",
        "flat": [
            "@fix",
            "@stan",
            "@test"
        ]
    },
    "authors": [
        {
            "name": "Vic Cherubini",
            "email": "vcherubini@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
